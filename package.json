{
  "name": "glow-tour",
  "private": true,
  "packageManager": "bun@1.1.42",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "playground": "bun run --cwd apps/playground dev"
  },
  "dependencies": {
    "@glowhop/observables": "^1.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  }
}
